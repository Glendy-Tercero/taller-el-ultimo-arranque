<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/material_dynamic_secondary20">

    <RelativeLayout
        android:id="@+id/relative_fondo_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <RelativeLayout
            android:id="@+id/relative_sup_main"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:background="@color/dark_blue">


            <TextView
                android:id="@+id/txt_superior_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:fontFamily="@font/tw_cen_mt"
                android:gravity="center"
                android:text="Taller 'El Último Arranque'"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <View
                android:id="@+id/divider_linea_sup"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="0dp"
                android:background="@color/blue" />

        </RelativeLayout>

        <ScrollView
            android:id="@+id/scroll_main"
            android:layout_width="match_parent"
            android:layout_height="644dp"
            android:layout_below="@id/relative_sup_main"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp">

            <RelativeLayout
                android:id="@+id/relative_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="1dp">

                <LinearLayout
                    android:id="@+id/layout_estado"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="100dp"
                    android:background="@drawable/yellow_border"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    card_view:cardElevation="3dp"
                    card_view:layout_constraintEnd_toEndOf="parent"
                    card_view:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/image_estado"
                        android:layout_width="100dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        card_view:srcCompat="@mipmap/orden" />

                    <TextView
                        android:id="@+id/txt_estado"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/arial_black"
                        android:gravity="center|bottom"
                        android:text="Órdenes por Estado"
                        android:textColor="@color/dark_grey"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_fecha"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_below="@+id/layout_estado"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="100dp"
                    android:background="@drawable/yellow_border"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    card_view:cardElevation="3dp"
                    card_view:layout_constraintEnd_toEndOf="parent"
                    card_view:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/image_fecha"
                        android:layout_width="100dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        card_view:srcCompat="@mipmap/calendario" />

                    <TextView
                        android:id="@+id/txt_fecha"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/arial_black"
                        android:gravity="center|bottom"
                        android:text="Órdenes por Fecha"
                        android:textColor="@color/dark_grey"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_vehiculo"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_below="@+id/layout_fecha"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="100dp"
                    android:background="@drawable/yellow_border"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    card_view:cardElevation="3dp">

                    <ImageView
                        android:id="@+id/image_vehiculo"
                        android:layout_width="100dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        app:srcCompat="@mipmap/vehiculo" />

                    <TextView
                        android:id="@+id/txt_vehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/arial_black"
                        android:gravity="center|bottom"
                        android:text="Órdenes por Vehículo"
                        android:textColor="@color/dark_grey"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_mecanico"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_below="@+id/layout_vehiculo"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="100dp"
                    android:background="@drawable/yellow_border"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    card_view:cardElevation="3dp"
                    card_view:layout_constraintEnd_toEndOf="parent"
                    card_view:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/image_mecanico"
                        android:layout_width="100dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        card_view:srcCompat="@mipmap/mecanico" />

                    <TextView
                        android:id="@+id/txt_mecanico"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/arial_black"
                        android:gravity="center|bottom"
                        android:text="Órdenes por Mecánico"
                        android:textColor="@color/dark_grey"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_repuesto"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_below="@+id/layout_mecanico"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="100dp"
                    android:background="@drawable/yellow_border"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    card_view:cardElevation="3dp"
                    card_view:layout_constraintEnd_toEndOf="parent"
                    card_view:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/image_repuesto"
                        android:layout_width="100dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        card_view:srcCompat="@mipmap/repuesto" />

                    <TextView
                        android:id="@+id/txt_repuesto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/arial_black"
                        android:gravity="center|bottom"
                        android:text="Repuestos con bajo inventario"
                        android:textColor="@color/dark_grey"
                        android:textSize="14sp" />

                </LinearLayout>

            </RelativeLayout>
        </ScrollView>

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>